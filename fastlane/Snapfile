# fastlane snapshot 설정
devices([
  "iPad Pro 13-inch (M5)",
  "iPad Pro 11-inch (M5)"
])
languages(["ko-KR"])
workspace("./Ink.xcworkspace")
scheme("Ink")
only_testing(["InkUITests/ScreenshotUITests"])
output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)
override_status_bar(true)
# 다른 UI 테스트와 시뮬레이터를 공유하므로 동시 실행은 끈다.
concurrent_simulators(false)
skip_open_summary(true)
