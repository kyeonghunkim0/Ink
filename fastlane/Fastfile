default_platform(:ios)

WORKSPACE = "Ink.xcworkspace"
SCHEME = "Ink"
SIMULATOR = "iPad Pro 11-inch (M5)"

platform :ios do
  before_all do
    sh("cd .. && tuist generate --no-open")
  end

  desc "tuist generate만 실행"
  lane :generate do
    # before_all에서 이미 생성됨
  end

  desc "시뮬레이터에서 단위/UI 테스트"
  lane :test do
    run_tests(
      workspace: WORKSPACE,
      scheme: SCHEME,
      devices: [SIMULATOR],
      output_directory: "fastlane/test_output",
      result_bundle: true
    )
  end

  desc "시뮬레이터용 디버그 빌드 (서명 없음)"
  lane :build do
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      skip_archive: true,
      skip_codesigning: true,
      skip_package_ipa: true
    )
  end

  desc "TestFlight 업로드 (빌드 번호 = 최신 TestFlight 빌드 + 1)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    build_number = latest_testflight_build_number(
      api_key: api_key,
      initial_build_number: 0
    ) + 1

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} -allowProvisioningUpdates",
      output_directory: "fastlane/build"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
